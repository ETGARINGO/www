<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mamcris Video</title>

  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
    }

    .video-frame {
      width: 100vw;
      height: 100vh;
      border: 0;
      display: block;
    }
  </style>
</head>

<body>

  <iframe
    class="video-frame"
    srcdoc='
      <!DOCTYPE html>
      <html>
      <head>
        <style>
          html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
          }

          video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
            background: #000;
          }
        </style>
      </head>

      <body>
        <video
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          <source src="Mamcris.mp4" type="video/mp4">
          Your browser does not support HTML5 video.
        </video>
      </body>
      </html>
    '
    allow="autoplay; fullscreen"
    scrolling="no">
  </iframe>

</body>
</html>
